# Copy to .env and export before `node server.js`. Every value has a default
# or is optional except the two secrets marked required.

# Where state lives. paper.db is SQLite in WAL mode and is created on first run.
PAPER_STATE_DIR=./state
PAPER_DB=./state/paper.db
PHOENIX_SNAPSHOT_FILE=./state/markets-snapshot.json
PAPER_MAINTENANCE_FILE=./state/deploy-maintenance

# Listen port (loopback only; put a reverse proxy in front).
PAPER_PORT=9200

# REQUIRED. The reverse proxy must send this as x-paper-gate; the engine
# refuses to serve without a gate.
PAPER_GATE_SECRET=change-me

# REQUIRED for the competition desk (x-comp-token on /api/paper/comp/admin).
PAPER_COMP_TOKEN=change-me

# Identity. The engine does not store users; it resolves the site session
# cookie through two secret-gated endpoints on PAPER_MAIN_BASE.
PAPER_MAIN_BASE=https://perp.so
PAPER_INTERNAL_SECRET=

# Optional inputs.
PAPER_SNAPSHOT_SRC=https://perp.so/markets-snapshot.json
WAREHOUSE_API_TOKEN=
TG_BOT_TOKEN=
OPS_ALERT_CHAT_ID=

# Build id stamped into /api/paper/config and the per-seat proofs.
PAPER_BUILD_ID=dev
